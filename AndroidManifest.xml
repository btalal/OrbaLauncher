<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.maison.accueil"
    android:versionCode="24"
    android:versionName="3.11.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Icône réseau de l'en-tête (Wi-Fi / Ethernet) : lecture de l'état de la connexion seulement -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ouvre la fenêtre de désinstallation d'Android (confirmation par l'utilisateur) : autorisation normale, sans demande -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ : déclarer quelles applis et quels réglages on a besoin de voir -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:label="Orba"
        android:icon="@drawable/icone"
        android:banner="@drawable/banniere"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Catégorie HOME : permet aussi d'utiliser Orba comme accueil natif
                 si le launcher d'origine est désactivé (ex. via ADB / CleanYourTV). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Écran de veille Orba (lancé par Orba après inactivité) -->
        <activity
            android:name=".VeilleActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:screenOrientation="landscape" />

        <!-- Le même écran, proposé comme économiseur d'écran Android -->
        <service
            android:name=".OrbaDream"
            android:exported="true"
            android:label="Orba"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Raccourci touche Accueil (à activer soi-même dans Paramètres > Accessibilité) -->
        <service
            android:name=".ToucheAccueilService"
            android:label="@string/service_nom"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/touche_accueil" />
        </service>
    </application>
</manifest>
